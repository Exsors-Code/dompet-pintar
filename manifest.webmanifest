{
 "id": "catatuang",
 "name": "CatatUang",
 "short_name": "CatatUang",
 "description": "Catat pengeluaran harian dan pemasukan bulanan, baca struk lewat foto, dan terima ringkasan tiap malam. Data tersimpan di perangkatmu.",
 "lang": "id",
 "dir": "ltr",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "tabbed",
  "standalone",
  "minimal-ui"
 ],
 "orientation": "any",
 "background_color": "#eef2f1",
 "theme_color": "#0f766e",
 "categories": [
  "finance",
  "productivity",
  "utilities"
 ],
 "scope_extensions": [
  {
   "type": "origin",
   "origin": "https://exsors-code.github.io"
  }
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "screenshots": [
  {
   "src": "screenshots/narrow.png",
   "sizes": "540x960",
   "type": "image/png",
   "form_factor": "narrow",
   "label": "Ringkasan pengeluaran hari ini"
  },
  {
   "src": "screenshots/wide.png",
   "sizes": "1280x720",
   "type": "image/png",
   "form_factor": "wide",
   "label": "Ringkasan pengeluaran hari ini"
  }
 ],
 "shortcuts": [
  {
   "name": "Tambah pengeluaran",
   "short_name": "Tambah",
   "url": "./?tab=add",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  },
  {
   "name": "Ringkasan bulan ini",
   "short_name": "Bulanan",
   "url": "./?tab=month",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  },
  {
   "name": "Foto struk",
   "short_name": "Struk",
   "url": "./?tab=add&scan=1",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  }
 ],
 "share_target": {
  "action": "./share-receipt",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "receipt",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 },
 "tab_strip": {
  "home_tab": "auto",
  "new_tab_button": {
   "url": "./?tab=add"
  }
 },
 "file_handlers": [
  {
   "action": "./?import=1",
   "name": "Cadangan CatatUang",
   "accept": {
    "application/json": [
     ".json"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": [
   "navigate-existing",
   "auto"
  ]
 },
 "protocol_handlers": [
  {
   "protocol": "web+catatuang",
   "url": "./?tab=add&q=%s"
  }
 ],
 "related_applications": [
  {
   "platform": "play",
   "id": "io.github.exsors_code.twa",
   "url": "https://play.google.com/store/apps/details?id=io.github.exsors_code.twa"
  }
 ],
 "prefer_related_applications": false,
 "edge_side_panel": {
  "preferred_width": 400
 },
 "note_taking": {
  "new_note_url": "./?tab=add"
 },
 "widgets": [
  {
   "name": "Pengeluaran hari ini",
   "short_name": "Hari ini",
   "description": "Total pengeluaranmu hari ini dan rinciannya.",
   "tag": "today",
   "ms_ac_template": "widgets/today-template.json",
   "data": "widgets/today-data.json",
   "type": "application/json",
   "auth": false,
   "update": 3600,
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ],
   "screenshots": [
    {
     "src": "screenshots/widget.png",
     "sizes": "400x400",
     "label": "Widget pengeluaran hari ini"
    }
   ]
  }
 ]
}